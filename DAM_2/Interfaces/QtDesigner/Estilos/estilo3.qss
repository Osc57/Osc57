QPushButton {
    margin: 5px;
    padding: 10px;
    background-color: white;
    color: green;
    border-style: solid;
    border-width: 3px;
    border-color: green;
    border-radius: 8px;
}

QPushButton#botonAceptar {
    background-color: white;
    border-color: red;
    color: red;
}

QLabel {
    color: rgb(37, 37, 233);
    font-weight: bold;
    font-size: 15px;
}

QLineEdit {
    border-style: solid;
    border-color: rgb(37, 37, 233);
    border-width: 1px;
    border-radius: 5px;
    padding: 3px;
}