QPushButton:hover{
    background-color: red;
}

QPushButton:pressed{
    background-color: yellow;
}

QRadioButton:checked{
    background-color: green;
}

/* off */
QComboBox:on{
    background-color: red;
}

QTabBar {
    color: white;
    font-weight: bold;
    background-color: black;
}

QDial{
    background-color: blue;
}

