QPushButton{
     background-color: white;
    color: black;
    border: 1.5px solid black;

    border-radius: 8px; 
    max-width: 25px; 

    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 19px;
    padding-right: 19px;
    
    margin: 1px;

    font-size: 15px;
    font-weight: bold;
}

QPushButton[text = "CE"]{
    min-width: 100px;
    max-width: 215px;
    color: white;
    background-color: rgb(1, 39, 250);
}

QPushButton[text = "+"]{
    color: white;
    background-color: rgb(1, 39, 250);
}

QPushButton[text = "="]{
    color: white;
    background-color: rgb(1, 39, 250);
}

QTextEdit{
    max-width: 215;
    min-width: 100px;

    max-height: 50px;
    min-height: 20px;
}

QMainWindow{
    background-color: lightgray;
}